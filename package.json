{
  "name": "amdwatch",
  "version": "0.2.0",
  "private": true,
  "description": "A community tracker for known issues in AMD Radeon driver release notes.",
  "type": "module",
  "homepage": "https://ryusuzaku.github.io/AMDWatch/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryusuzaku/AMDWatch.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test",
    "test:page": "node scripts/probe_page.mjs",
    "serve": "python -m http.server 8000 --bind 127.0.0.1",
    "validate": "python scripts/validate_tracker.py",
    "import": "python scripts/import_release_notes.py",
    "discover": "python scripts/discover_releases.py",
    "discover:archived": "python scripts/discover_archived.py",
    "backfill": "python scripts/backfill.py",
    "watch": "python scripts/watch_releases.py"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  },
  "comment": "The published site has no runtime dependencies and no build step. playwright is only used by the rendered-page smoke check in CI."
}
